# Kollepedia NG — environment for docker-compose.deploy.yml (+ docker-compose.alias.yml).
# Copy to `.env` next to the compose file on the server; never commit the real
# file. One .env per environment, with DIFFERENT secrets. The deploy workflows
# (re)write the four identity variables from repository variables and leave
# everything else alone. Full reference: docs/DRIFT.md.

# ── Identity ────────────────────────────────────────────────────────────────
# Names the compose project, containers (<APP_NAME>-server, -web), the data
# volume (<APP_NAME>-data), networks and Traefik routers. Match the directory
# name under /opt/.
APP_NAME=kollepedia
# The public host name Traefik routes to this stack, and its https origin
# (absolute links in mail, CORS, adapter-node's origin check).
PUBLIC_HOST=example.se
PUBLIC_ORIGIN=https://example.se
# Optional: alias host names that should redirect permanently to PUBLIC_HOST
# (a Traefik rule; activates docker-compose.alias.yml in the deploy workflows).
#ALIAS_HOSTS_RULE=Host(`www.example.se`) || Host(`old.example.org`)

# ── Secrets ─────────────────────────────────────────────────────────────────
# REQUIRED. Signs the HS256 auth JWTs; at least 32 characters, different per
# environment. Rotating it logs everyone out. Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# ── Outgoing mail (registration, verification, password reset) ─────────────
# Without SMTP_URL nothing is sent: mail stays in the super admin's outbox.
#SMTP_URL=smtp://username:password@smtp-relay.example.com:587
# Required when SMTP_URL is set. The domain needs SPF, DKIM and DMARC records.
#EMAIL_FROM=no-reply@example.se
# Who may receive mail. Exactly `*` = everyone (production). A comma-separated
# list = only those addresses. Unset while SMTP_URL is set = nobody (fail closed).
#EMAIL_ALLOWLIST=*

# ── Feature flags (server/app/features.py, web/src/lib/features.ts) ─────────
# Unfinished functionality ships dark; 1 switches it on in both containers.
FEATURE_AI=0

# ── Optional ────────────────────────────────────────────────────────────────
# Only used when the `postgres` profile is enabled (docs/DRIFT.md).
#POSTGRES_PASSWORD=change-me

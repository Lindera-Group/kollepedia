# Local development settings for the server (`uv run uvicorn app.main:app`).
# Copy to `.env` in server/ if you prefer a file over exported variables.

# Allow the X-User header as a stand-in for a login. Off by default; local
# development turns it on. Never set in a deployed environment.
DEV_AUTH=1

# Required when DEV_AUTH is off: at least 32 characters (openssl rand -hex 32).
# With DEV_AUTH=1 the built-in development value is tolerated.
#JWT_SECRET=

# SQLite (default): leave DATABASE_URL unset (server/data/kollepedia.db).
# Postgres (prepared, not yet in production use):
#DATABASE_URL=postgresql+psycopg://kollepedia:kollepedia@localhost:5433/kollepedia

# Feature flags (app/features.py): unfinished functionality is dark until on.
#FEATURE_AI=1
